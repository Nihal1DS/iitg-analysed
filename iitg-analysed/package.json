{
  "name": "iitg-analysed",
  "version": "1.0.0",
  "description": "Real-time IIT Guwahati intelligence dashboard — AI-powered news aggregation, research monitoring, and campus awareness.",
  "author": {
    "name": "Nihal Patel",
    "email": "nihalpatel.2802@gmail.com",
    "url": "https://github.com/Nihal1DS"
  },
  "license": "AGPL-3.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Nihal1DS/IITG-analysed.git"
  },
  "private": false,
  "type": "module",
  "scripts": {
    "dev": "vite --mode world",
    "dev:research": "vite --mode research",
    "dev:placements": "vite --mode placements",
    "dev:events": "vite --mode events",
    "dev:infra": "vite --mode infra",
    "build": "tsc -b && vite build",
    "build:full": "npm run typecheck && npm run build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src api server shared",
    "lint:fix": "biome check --write src api server shared",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "server": "node --experimental-specifier-resolution=node api/index.js",
    "server:dev": "tsx watch api/index.ts"
  },
  "dependencies": {
    "@deck.gl/core": "^9.0.0",
    "@deck.gl/layers": "^9.0.0",
    "@deck.gl/mapbox": "^9.0.0",
    "maplibre-gl": "^4.0.0",
    "three": "^0.168.0",
    "globe.gl": "^2.31.0",
    "protobufjs": "^7.4.0",
    "redis": "^4.7.0",
    "express": "^4.19.0",
    "cors": "^2.8.5",
    "node-fetch": "^3.3.2",
    "rss-parser": "^3.13.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@playwright/test": "^1.47.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "@types/three": "^0.168.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
