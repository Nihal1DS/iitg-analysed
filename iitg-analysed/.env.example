# ── Core ─────────────────────────────────────────────────────────────────────
# No environment variables are required for basic local operation.
# Copy this file to .env and fill in the values you need.

# ── API Server ────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:3000
VITE_RELAY_URL=http://localhost:3001

# ── AI / LLM Backend ─────────────────────────────────────────────────────────
# Options: ollama | groq | openrouter
VITE_LLM_BACKEND=ollama
VITE_OLLAMA_URL=http://localhost:11434

# If using Groq (cloud, fast):
# VITE_LLM_BACKEND=groq
# GROQ_API_KEY=your_groq_api_key_here

# If using OpenRouter (multi-model):
# VITE_LLM_BACKEND=openrouter
# OPENROUTER_API_KEY=your_openrouter_api_key_here

# ── External Data APIs ────────────────────────────────────────────────────────
# Scopus API for research publications (get free key at dev.elsevier.com)
SCOPUS_API_KEY=

# IMD Guwahati weather API (optional)
IMD_API_KEY=

# ── Caching ───────────────────────────────────────────────────────────────────
# Redis for caching feed data (optional — falls back to in-memory)
REDIS_URL=

# ── Deployment ───────────────────────────────────────────────────────────────
# Vercel (for deployment)
VERCEL_TOKEN=
